# ─── Newsletter ───────────────────────────────────────
# 'mailerlite' (domyślnie) albo 'brevo'
NEWSLETTER_PROVIDER=mailerlite

# MailerLite → Integrations → API → Generate new token
MAILERLITE_API_KEY=
# opcjonalne: ID grupy, do której trafiają zapisy z tej strony
MAILERLITE_GROUP_ID=

# Alternatywa: Brevo
# BREVO_API_KEY=
# BREVO_LIST_ID=
# BREVO_OPTIN_TEMPLATE_ID=
# BREVO_REDIRECT_URL=https://zakleterewiry.pl/newsletter-potwierdzony

# ─── Adres produkcyjny (kanoniczne URL-e, sitemap, JSON-LD) ───
NEXT_PUBLIC_SITE_URL=https://zakleterewiry.pl
